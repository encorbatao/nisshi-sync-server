# Port to listen on
PORT=4100
# Path to the SQLite database file (stores only ciphertext + routing metadata).
DB_PATH=./vault.db
# Shared code required to enroll a new account on this server. Give it to the
# people you want to have accounts; without it nobody can create one. Use a long
# random value.
ENROLLMENT_SECRET=
# Secret used to sign session tokens (HMAC-SHA256). Use a long random value.
# Rotating it invalidates all existing sessions (clients just log in again).
TOKEN_SECRET=
# Path to the newline-delimited file listing accepted record kinds. One kind per
# line; blank lines and #-comments ignored. The server refuses to start if this
# file is missing or contains no kinds.
RECORD_KINDS_FILE=./record-kinds.txt
